{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/100-Penteados-para-Cabelo-Cacheado-Infantil.pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"100-Penteados-para-Cabelo-Cacheado-Infantil.pdf\"" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
